cc_defaults {
    name: "dolby_c2_aidl_service_defaults",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    defaults: ["libcodec2-aidl-defaults"],
    srcs: ["DolbyC2Service.cpp"],
    shared_libs: [
        // First, as for the HIDL service: guards RefBase calls on null.
        "libshim_dolby",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
    ],
}

// Dolby audio decoders (AC-4, DD+) from libcodec2_store_dolby.so.
cc_binary {
    name: "vendor.dolby.media.c2-service",
    defaults: ["dolby_c2_aidl_service_defaults"],
    cflags: ["-DDOLBY_C2_INSTANCE=\"default1\""],
    shared_libs: ["libcodec2_store_dolby"],
    init_rc: ["vendor.dolby.media.c2-service.rc"],
}

// Dolby Vision codecs from c2.dolby.store.so.
cc_binary {
    name: "vendor.dolbyvision.media.c2-service",
    defaults: ["dolby_c2_aidl_service_defaults"],
    cflags: ["-DDOLBY_C2_INSTANCE=\"default2\""],
    shared_libs: ["c2.dolby.store"],
    init_rc: ["vendor.dolbyvision.media.c2-service.rc"],
}

// HIDL view of the QTI store for c2.dolby.client.so.
cc_binary {
    name: "vendor.dolbyvision.media.c2-qti-hidl-service",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    defaults: ["libcodec2-hidl-defaults"],
    srcs: ["QtiC2HidlStore.cpp"],
    shared_libs: [
        "libavservices_minijail",
        "libbinder",
        "libhidlbase",
    ],
    init_rc: ["vendor.dolbyvision.media.c2-qti-hidl-service.rc"],
}
